#!/bin/bash
set -e

here="$(dirname "$(readlink -f "$0")")"

export WINEPREFIX="$HOME/.config/pkhex_appimage/wineprefix"
export WINEARCH=win64
export WINEDLLOVERRIDES="dwrite,d2d1=b"

# * Persistent writable directories
pkhex_data="$HOME/.config/pkhex_appimage/data"
mkdir -p "$pkhex_data"/{bak,pkmdb,mgdb,sounds,template,trainers,plugins}

# * Version-aware cache using file size and modification time
# This guarantees AM upgrades trigger a fresh extraction, fixing the "won't open" bug.
if [ -n "${APPIMAGE:-}" ] && [ -f "$APPIMAGE" ]; then
    appimage_id="$(stat -c '%s-%Y' "$APPIMAGE" 2>/dev/null || echo "unknown")"
else
    appimage_id="appdir-$(stat -c '%Y' "$here/opt/pkhex/PKHeX.exe" 2>/dev/null || echo 0)"
fi

writable_cache="$HOME/.cache/pkhex_appimage/extracted/$appimage_id"

if [ ! -d "$writable_cache" ]; then
    echo "[PKHeX AppImage] Extracting to writable cache..."
    rm -rf "$HOME/.cache/pkhex_appimage/extracted"
    mkdir -p "$writable_cache"

    if [ -n "${APPIMAGE:-}" ] && [ -f "$APPIMAGE" ]; then
        # Extract AppImage into a temp dir, then move contents
        tmp_extract="$(mktemp -d)"
        ( cd "$tmp_extract" && "$APPIMAGE" --appimage-extract >/dev/null 2>&1 )
        mv "$tmp_extract/squashfs-root/"* "$writable_cache/"
        rm -rf "$tmp_extract"
    else
        # Running from AppDir directly (e.g., during testing)
        cp -a "$here/"* "$writable_cache/"
    fi
fi

# * Wine prefix init with retry logic (fixes first-run AM crash)
if [ ! -d "$WINEPREFIX" ]; then
    echo "[PKHeX AppImage] Initializing Wine prefix (first run only)..."
    mkdir -p "$WINEPREFIX"
    "$writable_cache/usr/bin/wine" wineboot --init 2>/dev/null || {
        echo "[PKHeX AppImage] Wine prefix init failed, recreating..."
        rm -rf "$WINEPREFIX"
        mkdir -p "$WINEPREFIX"
        "$writable_cache/usr/bin/wine" wineboot --init
    }
fi

# * Patch cfg.json
cfg_file="$writable_cache/opt/pkhex/cfg.json"
if [ ! -f "$cfg_file" ]; then
    echo '{}' > "$cfg_file"
fi

python3 - "$cfg_file" "$pkhex_data" <<'PYEOF'
import json, sys, os

cfg_file, data_dir = sys.argv[1], sys.argv[2]

try:
    with open(cfg_file, 'r') as f:
        cfg = json.load(f)
except Exception:
    cfg = {}

def to_wine_path(linux_path):
    # Convert /home/user/... to Z:\home\user\...
    # We use double backslashes here so the JSON file is encoded safely
    return "Z:" + linux_path.replace("/", "\\\\\\\\")

cfg['LocalResources'] = {
    'DatabasePath':     to_wine_path(os.path.join(data_dir, 'pkmdb')),
    'MGDatabasePath':   to_wine_path(os.path.join(data_dir, 'mgdb')),
    'BackupPath':       to_wine_path(os.path.join(data_dir, 'bak')),
    'SoundPath':        to_wine_path(os.path.join(data_dir, 'sounds')),
    'TemplatePath':     to_wine_path(os.path.join(data_dir, 'template')),
    'TrainerPath':      to_wine_path(os.path.join(data_dir, 'trainers')),
    'PluginPath':       to_wine_path(os.path.join(data_dir, 'plugins')),
}

with open(cfg_file, 'w') as f:
    json.dump(cfg, f, indent=2)
PYEOF

# * Launch from the writable extracted copy
# We 'cd' here so if PKHeX uses any relative paths internally, they stay in the cache.
cd "$writable_cache"
exec "$writable_cache/usr/bin/wine" "$writable_cache/opt/pkhex/PKHeX.exe" "$@"